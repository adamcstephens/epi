{
  "enabledPlugins": {},
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "veans prime",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "veans prime",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/worktree-create.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(openspec:*)",
      "Bash(dune:*)"
    ]
  },
  "plansDirectory": "./.claude/plans"
}
